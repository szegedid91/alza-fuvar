VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Fejlesztői gyors-belépés gombjai a bejelentkező oldalon.
# CSAK helyi futtatásnál jelenik meg (dev szerver vagy localhost preview) —
# éles domainen soha. A .env.local nincs verziókövetve, és a CI-ben nincs
# beállítva, így éles buildbe egyetlen jelszó sem kerülhet bele.
# Egy sorban, JSON tömbként. Mezők: label, email, password (kötelező), sub, icon.
# VITE_DEV_ACCOUNTS=[{"key":"crew1","label":"Munkatárs 1","sub":"crew — napi szerep a beosztásból","icon":"🧑‍🔧","email":"sofor.teszt@alza.hu","password":"JELSZO"},{"key":"crew2","label":"Munkatárs 2","sub":"crew — a páros másik tagja","icon":"🧑‍🏭","email":"rakodo.teszt@alza.hu","password":"JELSZO"},{"key":"manager","label":"Menedzser","sub":"beosztás, jóváhagyás, riportok","icon":"🧭","email":"manager.teszt@alza.hu","password":"JELSZO"},{"key":"admin","label":"Admin","sub":"bér, statisztika, napló","icon":"🛠️","email":"admin@alza.hu","password":"JELSZO"}]
